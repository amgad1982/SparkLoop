# ==============================================================================
# SparkLoop Production Core Stack (.env)
# Services: PostgreSQL 17, PgBouncer, Redis 7, Centrifugo v5, MinIO, Backend, Frontend
# Note: LiveKit SFU and Coturn STUN/TURN are hosted on the dedicated edge host (see TURN-SFU/)
# ==============================================================================

# Core Database (Postgres & PgBouncer)
POSTGRES_DB=sparkloop
POSTGRES_USER=sparkuser
POSTGRES_PASSWORD=sparkpassword123!

# Object Storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword123!

# Dedicated Edge SFU & TURN Configuration (Host: 92.4.162.183 / slooplive.mydev-lab.com)
LIVEKIT_URL=wss://slooplive.mydev-lab.com
LIVEKIT_API_KEY=sparkloop_livekit_key
LIVEKIT_API_SECRET=sparkloop_livekit_secret_2026_super_secure_32chars
LIVEKIT_TURN_SERVER=turn:92.4.162.183:3478
LIVEKIT_TURN_USERNAME=sparkloop
LIVEKIT_TURN_CREDENTIAL=SparkLoopTurnSecret2026Secure!

# Frontend Build Arguments
VITE_API_BASE_URL=https://sloopapi.mydev-lab.com/api
VITE_WS_URL=wss://sloopws.mydev-lab.com/connection/websocket
VITE_LIVEKIT_URL=wss://slooplive.mydev-lab.com

